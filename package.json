    "ai": "^7.0.106",
    "chalk": "^6.0.0",
    "commander": "^15.0.0",
    "dotenv": "^18.0.0",
    "fast-glob": "^3.3.3",
    "ink": "^7.1.1",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "react": "^19.3.0",
